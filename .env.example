# Server-side only. Never ship these values inside the Flutter app or the APK.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Telegram bot (optional). The bot answers only the private chat ID below.
TELEGRAM_BOT_TOKEN=123456789:AAEXAMPLE
TELEGRAM_CHAT_ID=123456789

# Optional local language model. Analysis and signals never depend on it.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Build-time values for the Flutter app (anon key only, never the service key).
# dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
